+    /**
+     * A3 change. Decide whether a Not-Recognized candidate [action] (a configured user A got a 401 on X)
+     * is confirmed, based on the rules enabled in the configuration.
+     * With no rule enabled, every candidate is confirmed, ie, the same behavior as EvoMaster 6.2.0.
+     *
+     * Rule 1, credential-differential evidence: A got a 2xx on some request r on an endpoint Y != X,
+     * and the identical request r sent without any credentials got 401 or 403.
+     * Rule 2, user attribution: the identical request of X, sent as another configured user B, did not get a 401.
+     *
+     * The replayed requests are added to the test by [RestSecurityBuilder]. Requests are compared with
+     * [requestSignature], which ignores the configured credentials (cookies/headers from the auth config)
+     * but keeps every request input, including schema-defined headers such as Authorization.
+     */
+    fun isNotRecognizedConfirmed(
+        action: RestCallAction,
+        individual: RestIndividual,
+        actionResults: List<ActionResult>
+    ): Boolean {
+
+        if(config.notRecognizedCredentialEvidence
+            && !hasCredentialDifferentialEvidence(action, individual, actionResults)){
+            return false
         }
+
+        if(config.notRecognizedUserAttribution
+            && !isNotRecognizedAttributableToUser(action, individual, actionResults)){
+            return false
+        }
+
+        return true
+    }
+
+    /**
+     * Rule 1. Is there evidence, in the same test, that the user of [action] is recognized by the API?
+     * That is, the user got a 2xx on an endpoint Y different from X, and the very same request sent
+     * without credentials was rejected with 401 or 403.
+     * Note: a redirect (eg 302 to a login page) is not considered evidence.
+     */
+    fun hasCredentialDifferentialEvidence(
+        action: RestCallAction,
+        individual: RestIndividual,
+        actionResults: List<ActionResult>
+    ): Boolean {
+
+        val actions = individual.seeMainExecutableActions()
+
+        val okForUser = actions.filter {
+            !it.auth.isNoAuth()
+                    && !it.auth.isDifferentFrom(action.auth)
+                    && it.getName() != action.getName() // the paper requires Y != X
+                    && StatusGroup.G_2xx.isInGroup(statusOf(it, actionResults))
+        }
+        if(okForUser.isEmpty()){
+            return false
+        }
+
+        val rejectedWithoutAuth = actions.filter {
+            it.auth.isNoAuth() && listOf(401, 403).contains(statusOf(it, actionResults))
+        }.map { requestSignature(it) }
+            .toSet()
+
+        return okForUser.any { rejectedWithoutAuth.contains(requestSignature(it)) }
+    }
+
+    /**
+     * Rule 2. Can the 401 on X be attributed to the user of [action]?
+     * That is, the very same request sent as a different configured user did not get a 401.
+     * If every other user gets a 401 as well, the 401 is likely due to the request inputs
+     * (eg, a second credential in a header), and not to the user.
+     */
+    fun isNotRecognizedAttributableToUser(
+        action: RestCallAction,
+        individual: RestIndividual,
+        actionResults: List<ActionResult>
+    ): Boolean {
+
+        val signature = requestSignature(action)
+
+        return individual.seeMainExecutableActions().any {
+            !it.auth.isNoAuth()
+                    && it.auth.isDifferentFrom(action.auth)
+                    && it.getName() == action.getName()
+                    && statusOf(it, actionResults).let { s -> s != null && s != 401 }
+                    && requestSignature(it) == signature
+        }
+    }
+
+    private fun statusOf(action: RestCallAction, actionResults: List<ActionResult>) : Int? {
+        return (actionResults.find { r -> r.sourceLocalId == action.getLocalId() } as RestCallResult?)
+            ?.getStatusCode()
+    }
+
+    /**
+     * String identifying all the inputs of a request, except for the configured auth info.
+     * Two copies of the same action, with different [RestCallAction.auth], have the same signature.
+     */
+    fun requestSignature(action: RestCallAction) : String {
+        val params = action.parameters
+            .filter { it !is UpdateForBodyParam }
+            .joinToString("&") { p ->
+                val value = p.seeGenes().joinToString(",") { g ->
+                    try {
+                        g.getValueAsRawString()
+                    } catch (e: Exception) {
+                        "?"
+                    }
+                }
+                "${p.javaClass.simpleName}:${p.name}=$value"
+            }
+        return "${action.verb}:${action.path}|$params"
     }
 
